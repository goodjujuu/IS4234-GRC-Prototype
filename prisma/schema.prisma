// ConductGuard data model. The platform only reads account activity, and never creates or
// verifies accounts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single demo clock keeps deadlines and rolling windows reproducible.
model DemoClock {
  id  Int      @id @default(1)
  now DateTime
}

model Branch {
  id           String          @id @default(cuid())
  code         Int             @unique
  name         String
  region       String
  weeklyTarget Int             // accounts per employee per week, set by the business
  employees    Employee[]
  accounts     AccountRecord[]
  complaints   Complaint[]
  targets      TargetChange[]
  cases        Case[]
  reports      SpeakUpReport[]
  dismissals   Dismissal[]
  users        User[]
}

model Employee {
  id         String          @id @default(cuid())
  name       String
  position   String          // peer group, e.g. "Personal Banker"
  isManager  Boolean         @default(false)
  status     String          @default("ACTIVE") // ACTIVE | DISMISSED
  branch     Branch          @relation(fields: [branchId], references: [id])
  branchId   String
  accounts   AccountRecord[]
  complaints Complaint[]
  scores     RiskScore[]
  cases      Case[]
  disputes   Dispute[]
  dismissals Dismissal[]
  user       User?
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  title         String
  role          String         // EMPLOYEE | TEAM_LEAD | CONDUCT_RISK | CHIEF_RISK_OFFICER | INTERNAL_AUDIT | AUDIT_COMMITTEE
  employee      Employee?      @relation(fields: [employeeId], references: [id])
  employeeId    String?        @unique
  branch        Branch?        @relation(fields: [branchId], references: [id])
  branchId      String?        // the team a team lead is scoped to
  notifications Notification[]
}

// Account activity, read-only to the platform. Customers appear only as pseudonymous references.
model AccountRecord {
  id                     String      @id @default(cuid())
  ref                    String      @unique
  customerRef            String
  product                String
  employee               Employee    @relation(fields: [employeeId], references: [id])
  employeeId             String
  branch                 Branch      @relation(fields: [branchId], references: [id])
  branchId               String
  openedAt               DateTime
  firstGenuineActivityAt DateTime?
  fundingSource          String      // EXTERNAL | INTERNAL_TRANSFER_ONLY | NONE
  closedAt               DateTime?
  contactChangeAt        DateTime?
  complaints             Complaint[]

  @@index([employeeId, openedAt])
  @@index([branchId, openedAt])
  @@index([openedAt])
}

model Complaint {
  id         String        @id @default(cuid())
  category   String        // DID_NOT_AUTHORISE | SERVICE | OTHER
  summary    String
  receivedAt DateTime
  account    AccountRecord @relation(fields: [accountId], references: [id])
  accountId  String
  employee   Employee      @relation(fields: [employeeId], references: [id])
  employeeId String
  branch     Branch        @relation(fields: [branchId], references: [id])
  branchId   String

  @@index([employeeId, receivedAt])
}

model TargetChange {
  id          String   @id @default(cuid())
  branch      Branch   @relation(fields: [branchId], references: [id])
  branchId    String
  oldTarget   Int
  newTarget   Int
  effectiveAt DateTime
  setBy       String
}

// One row per employee per scoring run. `metrics` keeps the full evidence for
// that score, so a past score still explains itself after config changes.
model RiskScore {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  branchId   String
  asOf       DateTime
  score      Int
  level      String   // LOW | MEDIUM | HIGH
  metrics    Json

  @@unique([employeeId, asOf])
  @@index([asOf])
}

model Case {
  id                 String      @id @default(cuid())
  ref                String      @unique
  kind               String      // EMPLOYEE_FLAG | BRANCH_PRESSURE | DISMISSAL_REVIEW | RETALIATION_GUARD
  title              String
  summary            String
  riskLevel          String      // MEDIUM | HIGH
  tier               String      // TEAM_LEAD | CONDUCT_RISK | CHIEF_RISK_OFFICER | AUDIT_COMMITTEE
  status             String      @default("OPEN") // OPEN | IN_REVIEW | CLOSED
  assignee           String?
  outcome            String?     // CLEARED | COACHING | INVESTIGATION | TARGET_REVIEW (manager and target cases only)
  closeReason        String?
  inCommitteeSummary Boolean     @default(false)
  evidence           Json?
  employee           Employee?   @relation(fields: [employeeId], references: [id])
  employeeId         String?
  branch             Branch?     @relation(fields: [branchId], references: [id])
  branchId           String?
  openedAt           DateTime
  firstActionAt      DateTime?
  deadlineAt         DateTime
  closedAt           DateTime?
  events             CaseEvent[]
  disputes           Dispute[]

  @@index([status, deadlineAt])
}

// The audit trail. Every change to a case's status or level appends a row.
model CaseEvent {
  id        String   @id @default(cuid())
  case      Case     @relation(fields: [caseId], references: [id])
  caseId    String
  action    String   // OPENED | ASSIGNED | REVIEW_STARTED | NOTE | ESCALATED | DISPUTED | DISPUTE_DECIDED | CLOSED | APPEALED | APPEAL_DECIDED
  actor     String
  note      String?
  evidence  Json?
  timestamp DateTime
}

model Dispute {
  id           String    @id @default(cuid())
  case         Case      @relation(fields: [caseId], references: [id])
  caseId       String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  employeeId   String
  type         String    @default("DISPUTE") // DISPUTE (decided by the reviewer) | APPEAL (decided by the audit committee)
  metricKey    String?
  statement    String
  evidence     String?
  status       String    @default("OPEN") // OPEN | UPHELD | REJECTED
  decidedBy    String?
  decisionNote String?
  createdAt    DateTime
  decidedAt    DateTime?
}

// Anonymous by design. `reporterSeal` is a one-way keyed hash, never a name, so
// the retaliation guard can recognise a reporter without revealing who they are.
model SpeakUpReport {
  id           String   @id @default(cuid())
  trackingCode String   @unique
  theme        String   // TARGET_PRESSURE | INSTRUCTED_MISCONDUCT | RETALIATION | OTHER
  message      String
  reporterSeal String?
  branch       Branch   @relation(fields: [branchId], references: [id])
  branchId     String
  createdAt    DateTime
}

model Dismissal {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  branch     Branch   @relation(fields: [branchId], references: [id])
  branchId   String
  category   String   // SALES_MISCONDUCT | OTHER
  reason     String
  dismissedAt DateTime
}

// Weights and thresholds. Only changed through an approved change request.
model ScoringConfig {
  key         String @id
  label       String
  group       String // WEIGHT | LEVEL | RULE | WATCH
  value       Float
  unit        String
  description String
}

model ThresholdChangeRequest {
  id            String    @id @default(cuid())
  configKey     String
  oldValue      Float
  newValue      Float
  reason        String
  requestedBy   String
  requesterRole String
  flagsBefore   Int
  flagsAfter    Int
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | BLOCKED
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime
  reviewedAt    DateTime?
}

// Append-only and hash-chained. Each hash covers the previous one.
model ConfigChangeLog {
  id          String   @id @default(cuid())
  seq         Int      @unique
  event       String   // PROPOSED | APPROVED | REJECTED | BLOCKED | SEEDED
  change      String
  changedBy   String
  signedOffBy String?
  prevHash    String?
  hash        String
  createdAt   DateTime
}

model WatcherAlert {
  id             String    @id @default(cuid())
  type           String    // THRESHOLD_CHANGE | UNAPPROVED_CHANGE | FLAG_VOLUME_DROP | FAST_REVIEWS | LOG_TAMPERING
  severity       String    // MEDIUM | HIGH
  title          String
  detail         String
  status         String    @default("OPEN") // OPEN | ACKNOWLEDGED
  acknowledgedBy String?
  createdAt      DateTime
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime

  @@index([userId, read])
}

model Briefing {
  id          String    @id @default(cuid())
  asOf        DateTime
  facts       Json
  draft       String    // the AI draft, kept unchanged even if a reviewer corrects it
  summary     String    // what readers see: the draft, or the reviewer's correction
  source      String    // AI_MODEL | SIMULATED
  status      String    @default("PENDING") // PENDING | CONFIRMED | CORRECTED
  confirmedBy String?
  confirmNote String?
  confirmedAt DateTime?
  createdAt   DateTime
}
