// IS4234 Group 26 — Sales Conduct & Incentive Risk Monitoring Platform
// Prisma schema. Models map to the M1–M7 modules described in docs/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String    @id @default(cuid())
  name      String
  region    String?
  bankers   Banker[]
  accounts  Account[]
  alerts    ConductAlert[]
  cases     Case[]
  reports   Report[]
  createdAt DateTime  @default(now())
}

model Banker {
  id         String    @id @default(cuid())
  name       String
  mobile     String?   // staff mobile — M1 blocks it being put on a customer account
  branch     Branch    @relation(fields: [branchId], references: [id])
  branchId   String
  accounts   Account[]
  alerts     ConductAlert[]
  cases      Case[]
  contactChanges ContactChangeRequest[]
  incentiveEvents IncentiveEvent[]
  reportsFiled Report[] @relation("ReportReporter")
  createdAt  DateTime  @default(now())
}

model Account {
  id               String    @id @default(cuid())
  customerName     String
  product          String    @default("Savings Account")
  branch           Branch    @relation(fields: [branchId], references: [id])
  branchId         String
  banker           Banker    @relation(fields: [bankerId], references: [id])
  bankerId         String

  // M2 — Independent Consent Gate
  status           String    @default("PENDING_CONSENT") // PENDING_CONSENT | ACTIVE | DECLINED | EXPIRED
  consentRequest   ConsentRequest?

  // M3 — Usage-Linked Incentive Engine
  incentiveStatus  String    @default("PROVISIONAL")      // PROVISIONAL | PAID | LAPSED
  incentiveAmount  Int       @default(50)                 // SGD sales credit for opening the account
  activatedAt      DateTime?
  lastUsedAt       DateTime?
  transactions     Transaction[]
  incentiveEvents  IncentiveEvent[]

  // M1 — Contact-Integrity Guard
  mobile           String?   // 8 digits, no spaces
  email            String?
  pinStatus        String    @default("NOT_SET")          // NOT_SET | LINK_SENT | SET_BY_CUSTOMER (the PIN itself is never stored here)
  pinSetAt         DateTime?
  contactChanges   ContactChangeRequest[]

  alerts           ConductAlert[]
  createdAt        DateTime  @default(now())
}

model ConsentRequest {
  id          String    @id @default(cuid())
  account     Account   @relation(fields: [accountId], references: [id])
  accountId   String    @unique
  channel     String    @default("SMS")   // SMS | DUAL_STAFF (no phone on file)
  status      String    @default("PENDING") // PENDING | APPROVED | DECLINED | EXPIRED
  sentAt      DateTime  @default(now())
  respondedAt DateTime?
}

model ConductAlert {
  id          String    @id @default(cuid())
  type        String                     // e.g. BLOCKED_CONTACT_CHANGE, UNUSED_ACCOUNT_90D, BRANCH_WIDE_PATTERN, RETALIATION_FLAGGED
  severity    String    @default("LOW")  // LOW | MEDIUM | HIGH
  source      String                     // M1 | M2 | M3 | M4 | M5
  description String

  branch      Branch?   @relation(fields: [branchId], references: [id])
  branchId    String?
  banker      Banker?   @relation(fields: [bankerId], references: [id])
  bankerId    String?
  account     Account?  @relation(fields: [accountId], references: [id])
  accountId   String?

  status      String    @default("OPEN") // OPEN | ESCALATED | DISMISSED
  dismissReason String?                  // M4/M7: dismissals are reported to the Board by reason
  dismissedBy   String?
  dismissedAt   DateTime?
  caseRecord  Case?

  createdAt   DateTime  @default(now())
}

model Case {
  id          String      @id @default(cuid())
  alert       ConductAlert @relation(fields: [alertId], references: [id])
  alertId     String      @unique

  branch      Branch?     @relation(fields: [branchId], references: [id])
  branchId    String?
  banker      Banker?     @relation(fields: [bankerId], references: [id])
  bankerId    String?

  level       String      @default("BRANCH") // BRANCH | CONDUCT_OFFICE | CRO
  status      String      @default("OPEN")   // OPEN | OVERDUE | RESOLVED
  deadlineAt  DateTime

  events      CaseEvent[]
  createdAt   DateTime    @default(now())
}

model CaseEvent {
  id        String   @id @default(cuid())
  caseRecord Case    @relation(fields: [caseId], references: [id])
  caseId    String
  action     String  // OPENED | ESCALATED | RESOLVED | NOTE
  actor      String
  note       String?
  timestamp  DateTime @default(now())
}

// M5 — Speak-Up Channel. Reports go straight to the second line and the
// Audit Committee; business-line management has no access.
model Report {
  id              String   @id @default(cuid())
  theme           String   // SALES_PRESSURE | UNAUTHORISED_ACCOUNTS | MISSELLING | RETALIATION | OTHER
  description     String
  status          String   @default("OPEN") // OPEN | REVIEWED | CLOSED
  branch          Branch?  @relation(fields: [branchId], references: [id])
  branchId        String?
  anonymous       Boolean  @default(true)
  reporter        Banker?  @relation("ReportReporter", fields: [reporterId], references: [id])
  reporterId      String?  // only set when the reporter chose to be named
  trackingCode    String?
  routedTo        String   @default("Second-line Risk & Audit Committee")
  retaliationFlag Boolean  @default(false)
  retaliationNote String?
  createdAt       DateTime @default(now())
}

model ConfigChangeLog {
  id          String   @id @default(cuid())
  change      String   // e.g. "Raised unused-account threshold from 60 to 90 days"
  changedBy   String
  signedOffBy String   // second-line sign-off, required by M7
  prevHash    String?  // hash of the previous entry — links the chain
  hash        String   // SHA-256 over this entry + prevHash — tamper-evidence
  createdAt   DateTime @default(now())
}

// M1 — every staff-initiated change to a customer's mobile or email, whether
// blocked by the rules, cancelled by the customer, or applied.
model ContactChangeRequest {
  id          String    @id @default(cuid())
  account     Account   @relation(fields: [accountId], references: [id])
  accountId   String
  banker      Banker    @relation(fields: [bankerId], references: [id])
  bankerId    String
  field       String    // MOBILE | EMAIL
  oldValue    String?
  newValue    String
  status      String    // BLOCKED | PENDING_COOLING_OFF | CONFIRMED_BY_CUSTOMER | APPLIED_AFTER_COOLING_OFF | CANCELLED_BY_CUSTOMER
  blockReason String?
  effectiveAt DateTime? // end of the 48-hour cooling-off period
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// M3 — account activity. Only customer-initiated activity counts as genuine
// use; staff-initiated funding (e.g. transfer-in then reversal) does not.
model Transaction {
  id          String   @id @default(cuid())
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  kind        String   // CARD_PAYMENT | SALARY_CREDIT | BILL_PAYMENT | STAFF_TRANSFER_IN | STAFF_REVERSAL
  amountCents Int      // positive = money in, negative = money out
  description String
  initiatedBy String   // CUSTOMER | STAFF
  createdAt   DateTime @default(now())
}

// M3 — the banker's incentive ledger: credit is provisional until the
// customer genuinely uses the account, then paid or lapsed.
model IncentiveEvent {
  id        String   @id @default(cuid())
  banker    Banker   @relation(fields: [bankerId], references: [id])
  bankerId  String
  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?
  kind      String   // PROVISIONAL | PAID | LAPSED | RETENTION_BONUS
  amount    Int      // SGD
  note      String
  createdAt DateTime @default(now())
}

// M4 detection thresholds — changed only through M7 (maker-checker sign-off).
model Threshold {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  value       Float
  unit        String   // PERCENT | COUNT
  description String
  updatedAt   DateTime @updatedAt
}

// M7 — a proposed threshold change awaiting independent second-line sign-off.
model ThresholdChangeRequest {
  id           String    @id @default(cuid())
  thresholdKey String
  oldValue     Float
  newValue     Float
  reason       String
  requestedBy  String
  status       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedBy   String?
  reviewNote   String?
  flagsBefore  Int       // M4 breaches under the current value
  flagsAfter   Int       // ... under the proposed value (suppression check)
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
}

// M4 — each run of the conduct analytics engine (feeds M7's coverage report).
model AnalyticsRun {
  id              String   @id @default(cuid())
  alertsRaised    Int
  bankersScanned  Int
  branchesScanned Int
  createdAt       DateTime @default(now())
}
