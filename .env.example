# Copy to .env and fill in once you've created a free Neon (or Vercel) Postgres project.
# See docs/DEPLOYMENT.md for the full setup.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs demo login cookies and speak-up seals. Use any long random string when hosting.
SESSION_SECRET="change-me"

# Google AI Studio API key. With a key, "Generate again" on the briefing page calls a live AI model.
# Without one, the briefing uses a template draft that is labelled as a template.
GEMINI_API_KEY=""

# Optional model override.
GEMINI_MODEL="gemini-3.6-flash"
